{
  "name": "browser-toolbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "adblock:lists": "node scripts/adblock/build-filter-lists.mjs",
    "adblock:scripts": "node scripts/build-adblock-scripts.mjs",
    "build": "node scripts/copy-postman-sandbox.mjs && npm run adblock:scripts && tsc -b && vite build",
