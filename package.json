    "postman-lite": "file:../postman-lite",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
